# Copy to .env and fill in. Never commit .env.
# Restrict this key in Google Cloud: API = Map Tiles API only; HTTP referrers = http://localhost:*, http://127.0.0.1:*
# Set a daily quota cap and a billing budget alert. Browser keys are visible to anyone running the app.
VITE_GOOGLE_MAPS_API_KEY=your-restricted-key-here
