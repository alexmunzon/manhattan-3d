#!/bin/sh
# Blocks commits that contain secrets. Install gitleaks: https://github.com/gitleaks/gitleaks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed — refusing to commit without a secret scan." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
